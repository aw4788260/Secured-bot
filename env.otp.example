# Add these to your existing .env.local (and to your host's env panel)

# SMTP relay — same one that worked in your python3 test
SMTP_HOST=relay.hostup.se
SMTP_PORT=587
SMTP_FROM=no-reply@medaad.online
# Leave SMTP_USER / SMTP_PASS empty if the relay is IP-whitelisted (like your
# python test, which never called smtp.login()). Fill them in only if Hostup
# later requires authentication.
SMTP_USER=
SMTP_PASS=
